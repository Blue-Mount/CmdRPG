  "abilities": {
    "action_surge": {
      "name": "动作如潮",
      "effect": "action_surge",
      "cost": "free",
      "level": 0,
      "range": 0,
      "description": "恢复一个动作；不消耗动作或附赠动作，每次短休一次。",
      "resource": "action_surge"
    },
    "rally": {
      "name": "战技：鼓舞",
      "effect": "rally",
      "cost": "bonus",
      "level": 0,
      "range": 9,
      "description": "队友获得8点临时生命；倒地队友先恢复1生命。消耗一枚优越骰。",
      "resource": "superiority"
    },
    "flurry": {
      "name": "疾风连击",
      "effect": "flurry",
      "cost": "bonus",
      "level": 0,
      "range": 1.5,
      "description": "消耗一气点，对相邻敌人连续两次徒手攻击。",
      "resource": "ki"
    },
    "patient_defence": {
      "name": "耐心防御",
      "effect": "patient_defence",
      "cost": "bonus",
      "level": 0,
      "range": 0,
      "description": "消耗一气点，获得闪避直到下回合。",
      "resource": "ki"
    },
    "scorching_ray": {
      "name": "灼热射线",
      "effect": "scorching_ray",
      "cost": "action",
      "level": 2,
      "range": 18,
      "description": "三条射线可分别分配可见敌人（允许重复），每条独立命中造成2d6火焰；升环每环加一条。"
    },
    "fireball": {
      "name": "火球术",
      "effect": "fireball",
      "cost": "action",
      "level": 3,
      "range": 18,
      "description": "选择18米内可见地面落点或敌人中心；6米内8d6火焰，敏捷豁免减半；塑能保护友军。"
    },
    "aid": {
      "name": "援助术",
      "effect": "aid",
      "cost": "action",
      "level": 2,
      "range": 9,
      "description": "9米内可见队友生命上限与当前生命增加5，每升一环额外5；本场同名取较高值，不重复治疗。"
    },
    "mass_healing_word": {
      "name": "群体治愈真言",
      "effect": "mass_healing_word",
      "cost": "bonus",
      "level": 3,
      "range": 18,
      "description": "治疗18米内至多六个可见队友 1d4+感知+生命领域加成；升环增加骰数。"
    },
    "preserve_life": {
      "name": "引导神力：维持生命",
      "effect": "preserve_life",
      "cost": "action",
      "level": 0,
      "range": 9,
      "description": "9米内可见队友恢复三倍牧师等级生命。",
      "resource": "channel"
    },
    "stunning_strike": {
      "name": "震慑拳",
      "effect": "stunning_strike",
      "cost": "action",
      "level": 0,
      "range": 1.5,
      "resource": "ki",
      "description": "一次近战武器攻击，可接续额外攻击；仅命中时消耗1气，目标体质豁免失败则震慑至施术者下次回合结束。"
    },
    "blight": {
      "name": "枯萎术",
      "effect": "blight",
      "cost": "action",
      "level": 4,
      "range": 9,
      "description": "9米内可见敌人体质豁免，失败受到8d8黯蚀伤害，成功减半。不需专注。"
    },
    "death_ward": {
      "name": "死亡防护",
      "effect": "death_ward",
      "cost": "action",
      "level": 4,
      "range": 1.5,
      "description": "相邻仍有生命的队友获得死亡防护：本场首次被伤害降至0生命时改为1，随后消耗；同名不叠加，不需专注，跨场清除。"
    }
  },
